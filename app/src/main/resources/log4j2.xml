<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

    <Appenders>

        <Console name="ConsoleAppender">
            <PatternLayout pattern="%d{yyyy-MM-dd hh:mm:ss a} | %-5level | %msg%n"/>
        </Console>

        <File
                name="FileAppender"
                fileName="applogs/application_logs.log"
                append="true">

            <PatternLayout
                    pattern="%d{yyyy-MM-dd hh:mm:ss a} | %-5level | %msg%n"/>

        </File>

    </Appenders>

    <Loggers>

        <Root level="info">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Root>

    </Loggers>

</Configuration>